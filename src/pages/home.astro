---
import rawPhotos from '../photo-manifest.json';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const cloudName = 'hqxaxhvx';
const cloudUrl = (publicId, width, quality = 'auto') => `https://res.cloudinary.com/${cloudName}/image/upload/f_auto,q_${quality},w_${width},c_limit/${publicId}`;
const photos = Object.fromEntries(Object.entries(rawPhotos).map(([album, images]) => [album, images.map((image, index) => {
  const publicId = `kyo-portfolio/${album}/${String(index + 1).padStart(2, '0')}`;
  return {
    ...image,
    src: cloudUrl(publicId, 1600),
    thumb: cloudUrl(publicId, 720, 'auto:good'),
    srcset: [480, 720, 1200, 1600, 2200].map((width) => `${cloudUrl(publicId, width)} ${width}w`).join(', '),
  };
})]));

const series = [
  { id: 'miyajima', place: '宫岛', en: 'MIYAJIMA', season: '秋', seasonEn: 'AUTUMN', date: '2025.11', picks: [0, 3] },
  { id: 'onomichi', place: '尾道', en: 'ONOMICHI', season: '夏', seasonEn: 'SUMMER', date: '2025.10', picks: [5, 1] },
  { id: 'kyoto', place: '京都', en: 'KYOTO', season: '秋', seasonEn: 'AUTUMN', date: '2025.12', picks: [0, 8] },
  { id: 'hokkaido', place: '北海道', en: 'HOKKAIDO', season: '冬', seasonEn: 'WINTER', date: '2026.02', picks: [4, 7] },
  { id: 'hiroshima', place: '广岛', en: 'HIROSHIMA', season: '夏', seasonEn: 'SUMMER', date: '2025.09', picks: [5, 0] },
  { id: 'tokyo', place: '东京', en: 'TOKYO', season: '冬', seasonEn: 'WINTER', date: '2026.01', picks: [3, 6] },
];

const tiles = series.flatMap((item, index) => item.picks.map((pick, pickIndex) => ({
  ...item,
  image: photos[item.id][pick],
  lane: (index * 2 + pickIndex) % 3,
  direction: (index * 2 + pickIndex) % 2 ? 1 : -1,
})));

const cover = photos.kyoto[8];
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="阿柘 kyo 的个人摄影作品集首页" />
    <title>阿柘 / kyo — Somewhere, in season.</title>
    <style is:global>
      @import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@300;400;500&family=Noto+Serif+SC:wght@400;500&display=swap');
      :root{--paper:#efeee8;--ink:#11110f;--muted:#76746e;--line:rgba(17,17,15,.22);--ease:cubic-bezier(.2,.75,.2,1)}
      *{box-sizing:border-box} html{background:var(--paper);scroll-behavior:smooth} body{margin:0;background:var(--paper);color:var(--ink);font-family:'DM Sans',sans-serif;font-weight:300;overflow-x:hidden} a{color:inherit;text-decoration:none} button{font:inherit;color:inherit}
      .topbar{position:fixed;inset:0 0 auto;z-index:10;height:76px;display:flex;align-items:center;justify-content:space-between;padding:0 24px;pointer-events:none}
      .mark,.nav-dock{pointer-events:auto;color:#f8f1e9;background:rgba(25,17,12,.54);border:1px solid rgba(255,244,228,.22);box-shadow:0 10px 34px rgba(23,10,3,.16);backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px)}
      .mark{display:flex;gap:10px;align-items:baseline;padding:10px 14px;border-radius:999px;font-family:'Noto Serif SC';font-size:15px;letter-spacing:.04em}.mark small{font:8px 'DM Sans';letter-spacing:.23em;color:rgba(255,244,228,.62)}
      .nav-dock{display:flex;align-items:center;gap:3px;padding:4px;border-radius:999px}
      .dock-link{position:relative;display:grid;place-items:center;min-width:66px;height:38px;padding:0 15px;border-radius:999px;font-size:10px;letter-spacing:.14em;transition:transform .3s var(--ease),background .3s var(--ease),color .3s var(--ease)}
      .dock-link:hover{transform:translateY(-3px) scale(1.04);background:rgba(255,255,255,.11)}.dock-link.is-current{background:#f3ede5;color:#21150f}.dock-link.is-current:after{content:'';position:absolute;bottom:5px;width:3px;height:3px;border-radius:50%;background:#a24724}
      .cover{position:relative;z-index:1;height:100svh;min-height:600px;overflow:hidden;background:#8a3a1d;color:#fff}.cover-image{display:block;width:100%;height:100%;object-fit:cover;object-position:center;image-rendering:auto}.cover:after{content:'';position:absolute;inset:0;background:linear-gradient(180deg,#00000014,#00000005 55%,#0000002b);pointer-events:none}.cover-caption{position:absolute;z-index:1;inset:0;display:grid;place-items:center;text-align:center;font-size:11px;line-height:1.35;letter-spacing:.08em;text-transform:uppercase}.cover-meta{position:absolute;z-index:1;left:28px;bottom:24px;margin:0;font-size:9px;letter-spacing:.2em}.cover-credit{position:absolute;z-index:1;right:28px;bottom:24px;margin:0;font-size:9px;letter-spacing:.18em}
      .scroll-stage{height:425vh;position:relative;background:var(--paper)}.sticky-world{height:100vh;position:sticky;top:0;overflow:hidden;padding:0 1.6667vw;will-change:transform}
      .eyebrow{position:absolute;top:calc(70px + 24px);left:28px;margin:0;font-size:9px;letter-spacing:.22em;color:var(--muted)}.progress{position:absolute;left:28px;bottom:26px;width:76px;height:1px;background:#c3c1ba}.progress i{display:block;width:0;height:100%;background:var(--ink)}.scroll-note{position:absolute;right:28px;bottom:24px;margin:0;font-size:9px;letter-spacing:.2em;color:var(--muted)}
      .content{position:relative;z-index:1;display:flex;flex-direction:column;justify-content:center;align-items:center;width:100%;height:100vh;text-align:center}.content__title{width:min(64.1667vw,924px);font:400 min(7.2222vw,104px)/1.15 'Noto Serif SC';letter-spacing:-.02em;margin:0;text-wrap:balance}.content__title em{font-style:normal;display:block}.content__description{width:min(31.6vw,455px);margin:24px 0 0;font-size:min(.9722vw,14px);line-height:1.3;letter-spacing:.12em;color:#4f4d47;text-transform:uppercase}.content__button{margin-top:30px;padding:10px 14px;border-bottom:1px solid currentColor;font-size:10px;letter-spacing:.18em;text-transform:uppercase;transition:letter-spacing .35s var(--ease)}.content__button:hover{letter-spacing:.28em}
      .gallery{position:absolute;top:50%;left:50%;transform:translate3d(-50%,-50%,0);width:min(51.1111vw,736px);pointer-events:none}.grid{display:grid;grid-template-columns:repeat(3,1fr);column-gap:min(2.2222vw,32px);row-gap:min(2.7778vw,40px);will-change:transform}.tile{position:relative;overflow:hidden;width:100%;aspect-ratio:1;background:#d3d1ca;will-change:transform;transform:translateZ(0);backface-visibility:hidden}.tile img{display:block;width:100%;height:100%;object-fit:cover;image-rendering:auto;transform:translateZ(0)}
      .after{min-height:100vh;background:#151513;color:#efeee8;padding:clamp(90px,12vw,180px) 5vw 72px;display:grid;align-content:space-between;gap:100px}.after h2{font:400 clamp(45px,8vw,120px)/.92 'Noto Serif SC';letter-spacing:-.06em;margin:0;max-width:850px}.after-bottom{display:flex;align-items:end;justify-content:space-between;gap:24px;border-top:1px solid #4c4b46;padding-top:20px}.after p{font-size:12px;line-height:1.8;color:#aaa79d;margin:0;max-width:300px}.enter{display:inline-flex;align-items:center;gap:15px;font-size:10px;letter-spacing:.2em}.enter i{display:block;width:50px;height:1px;background:#efeee8;transition:width .45s var(--ease)}.enter:hover i{width:92px}
      @media(max-width:720px){.topbar{height:66px;padding:0 12px}.mark{padding:9px 11px}.dock-link{min-width:54px;height:34px;padding:0 11px}.cover{min-height:540px}.cover-meta{left:17px;bottom:18px}.cover-credit{right:17px;bottom:18px}.eyebrow{top:83px;left:17px}.scroll-note{right:17px;bottom:18px}.progress{left:17px;bottom:20px}.gallery{width:84vw}.grid{column-gap:9px;row-gap:11px}.content__title{width:92vw;font-size:clamp(45px,14vw,74px);line-height:1}.content__description{width:78vw;font-size:9px;line-height:1.7;letter-spacing:.12em}.after{padding-inline:20px}.after-bottom{align-items:flex-start;flex-direction:column}}
      @media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}.dock-link,.enter i{transition:none!important}.tile img{transition:none!important}}
    </style>
  </head>
  <body>
    <header class="topbar">
      <a class="mark" href={`${base}/home/`} aria-label="阿柘 Kyo 首页">阿柘 <small>KYO</small></a>
      <nav class="nav-dock" aria-label="主导航"><a class="dock-link is-current" href={`${base}/home/`} aria-current="page">首页</a><a class="dock-link" href={`${base}/`}>作品</a></nav>
    </header>
    <main>
      <section class="cover" aria-label="摄影作品集封面">
        <img class="cover-image" src={cover.src} srcset={cover.srcset} sizes="100vw" width={cover.width} height={cover.height} alt="京都秋季红叶摄影" fetchpriority="high" decoding="async" />
        <div class="cover-caption">KYO PHOTOGRAPHY<br />A STUDY OF PLACE AND SEASON</div>
        <p class="cover-meta">#PLACE&nbsp;&nbsp;#SEASON&nbsp;&nbsp;#LIGHT</p>
        <p class="cover-credit">PHOTOGRAPHY BY 阿柘 / KYO</p>
      </section>
      <section class="block block--main scroll-stage" aria-label="摄影作品集首页">
        <div class="block__wrapper sticky-world">
          <p class="eyebrow">阿柘 / KYO — PHOTOGRAPHS 2025—2026</p>
          <div class="gallery" aria-hidden="true"><div class="gallery__grid grid">{tiles.map((tile) => <figure class="gallery__item tile"><img class="gallery__image" src={tile.image.thumb} srcset={tile.image.srcset} sizes="(max-width:720px) 34vw, 18vw" alt="" loading="eager" decoding="async" /><figcaption></figcaption></figure>)}</div></div>
          <div class="content center-copy"><h1 class="content__title">Somewhere,<em>in season.</em></h1><p class="content__description">A structured, scroll-driven archive of place, season and light.</p><a class="content__button" href={`${base}/`}>进入作品</a></div>
          <div class="progress" aria-hidden="true"><i></i></div><p class="scroll-note">SCROLL TO JOURNEY</p>
        </div>
      </section>
      <section class="after"><h2>Follow the light,<br />then enter the work.</h2><div class="after-bottom"><p>地点是章节，季节是线索。<br />所有影像都收录在作品内容页。</p><a class="enter" href={`${base}/`}><span>进入作品</span><i></i></a></div></section>
    </main>
    <script>
      import Lenis from 'lenis';
      import imagesLoaded from 'imagesloaded';
      import { gsap } from 'gsap';
      import { ScrollTrigger } from 'gsap/ScrollTrigger';
      gsap.registerPlugin(ScrollTrigger);

      class StickyGridScroll {
        constructor(){
          this.block = document.querySelector('.block--main');
          this.wrapper = this.block?.querySelector('.block__wrapper');
          this.content = this.block?.querySelector('.content');
          this.title = this.block?.querySelector('.content__title');
          this.description = this.block?.querySelector('.content__description');
          this.button = this.block?.querySelector('.content__button');
          this.grid = this.block?.querySelector('.gallery__grid');
          this.items = [...(this.block?.querySelectorAll('.gallery__item') || [])];
          this.progress = this.block?.querySelector('.progress i');
          this.initContent();
          this.groupItemsByColumn();
          this.addParallaxOnScroll();
          this.animateTitleOnScroll();
          this.animateGridOnScroll();
        }
        initContent(){
          gsap.set([this.description,this.button],{opacity:0,pointerEvents:'none'});
          const dy = (this.content.offsetHeight-this.title.offsetHeight)/2;
          this.titleOffsetY = (dy/this.content.offsetHeight)*100;
          gsap.set(this.title,{yPercent:this.titleOffsetY});
        }
        groupItemsByColumn(){
          this.columns = Array.from({length:3},()=>[]);
          this.items.forEach((item,index)=>this.columns[index%3].push(item));
        }
        addParallaxOnScroll(){
          gsap.from(this.wrapper,{yPercent:-100,ease:'none',scrollTrigger:{trigger:this.block,start:'top bottom',end:'top top',scrub:true}});
        }
        animateTitleOnScroll(){
          gsap.from(this.title,{opacity:0,duration:.7,ease:'power1.out',scrollTrigger:{trigger:this.block,start:'top 57%',toggleActions:'play none none reset'}});
        }
        gridRevealTimeline(){
          const timeline = gsap.timeline();
          const wh = innerHeight;
          const dy = wh-(wh-this.grid.offsetHeight)/2;
          this.columns.forEach((column,index)=>timeline.from(column,{y:dy*(index%2===0?-1:1),stagger:{each:.06,from:index%2===0?'end':'start'},ease:'power1.inOut'},'grid-reveal'));
          return timeline;
        }
        gridZoomTimeline(){
          const timeline = gsap.timeline({defaults:{duration:1,ease:'power3.inOut'}});
          timeline.to(this.grid,{scale:2.05}).to(this.columns[0],{xPercent:-40},'<').to(this.columns[2],{xPercent:40},'<').to(this.columns[1],{yPercent:index=>(index<Math.floor(this.columns[1].length/2)?-1:1)*40,duration:.5,ease:'power1.inOut'},'-=.5');
          return timeline;
        }
        toggleContent(visible=true){
          gsap.timeline({defaults:{overwrite:true}}).to(this.title,{yPercent:visible?0:this.titleOffsetY,duration:.7,ease:'power2.inOut'}).to([this.description,this.button],{opacity:visible?1:0,duration:.4,ease:`power1.${visible?'inOut':'out'}`,pointerEvents:visible?'all':'none'},visible?'-=90%':'<');
        }
        animateGridOnScroll(){
          const timeline = gsap.timeline({scrollTrigger:{trigger:this.block,start:'top 25%',end:'bottom bottom',scrub:true,invalidateOnRefresh:true,onUpdate:self=>{this.progress.style.width=`${self.progress*100}%`;}}});
          timeline.add(this.gridRevealTimeline()).add(this.gridZoomTimeline(),'-=.6').add(()=>this.toggleContent(timeline.scrollTrigger.direction===1),'-=.32');
        }
      }

      function initSmoothScrolling(){
        const lenis = new Lenis({lerp:.08,wheelMultiplier:1.4});
        lenis.on('scroll',ScrollTrigger.update);
        gsap.ticker.add(time=>lenis.raf(time*1000));
        gsap.ticker.lagSmoothing(0);
      }

      if(matchMedia('(prefers-reduced-motion: reduce)').matches){
        gsap.set(['.content__description','.content__button'],{opacity:1,pointerEvents:'all'});
      }else{
        new Promise(resolve=>imagesLoaded(document.querySelectorAll('.gallery img'),{background:true},resolve)).then(()=>{
          initSmoothScrolling();
          new StickyGridScroll();
          ScrollTrigger.refresh();
        });
      }
    </script>
  </body>
</html>

